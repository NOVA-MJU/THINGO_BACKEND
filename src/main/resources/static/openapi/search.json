    "/search/suggest": {
      "get": {
        "tags": [
          "Suggest"
        ],
        "summary": "표준 핵심어 자동완성",
        "description": "검색창 입력 중 재사용 가능한 짧은 핵심어를 최대 10개 반환합니다. 공지 제목은 반환하지 않습니다.\n\n후보는 기존 검색 의도 사전과 공통 Topic Catalog에서 가져오며 정확 일치, 시작 일치, 포함 일치 순으로 정렬합니다. 등록된 약어와 특수문자 변형은 표준 Topic 핵심어로 확장합니다.\n\nkeyword는 필수입니다. 공백, 2글자 미만 또는 등록되지 않은 표현은 200과 빈 배열을 반환하며, 낮은 신뢰도의 공지 제목으로 보완하지 않습니다. 기존 ApiResponse<List<String>> 계약은 유지됩니다.",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "장학"
          }
        ],
        "responses": {
          "200": {
            "description": "표준 핵심어 추천 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseStringList"
                },
                "example": {
                  "status": "API 요청 성공",
                  "data": [
                    "장학",
                    "장학생",
                    "국가장학",
                    "교내장학",
                    "한국장학재단"
                  ],
                  "timestamp": "2026-08-01T10:00:00.000000"
                }
              }
            }
          },
          "400": {
            "description": "필수 파라미터 keyword 누락",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": 400,
                  "error": "BAD_REQUEST",
                  "message": "Required request parameter 'keyword' for method parameter type String is not present"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponsePageSearchResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
